<%- include('partials/header', { title: 'テンプレート管理' }) %>

<style>
  /* 画面全体ドラッグドロップオーバーレイ */
  .drag-drop-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(11, 15, 25, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    pointer-events: none;
  }
  
  .drag-drop-overlay.show {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  
  .drag-drop-overlay-content {
    border: 3px dashed var(--color-primary);
    border-radius: 20px;
    padding: 3rem 2rem;
    text-align: center;
    background: rgba(255, 255, 255, 0.03);
    max-width: 480px;
    width: 90%;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    transform: scale(0.9);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    pointer-events: none;
  }
  
  .drag-drop-overlay.show .drag-drop-overlay-content {
    transform: scale(1);
  }
  
  @keyframes bounce-up-down {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  
  .bounce-icon {
    animation: bounce-up-down 2s infinite ease-in-out;
  }
</style>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <div>
    <div style="display: inline-flex; gap: 0.5rem; margin-bottom: 0.5rem;">
      <a href="/" class="btn btn-secondary" style="padding: 0.25rem 0.75rem; font-size: 0.8rem;">
        <i data-lucide="layout-dashboard" style="width: 12px; height: 12px; vertical-align: middle;"></i> 契約一覧
      </a>
      <span class="btn btn-primary" style="padding: 0.25rem 0.75rem; font-size: 0.8rem; pointer-events: none;">
        <i data-lucide="layout-template" style="width: 12px; height: 12px; vertical-align: middle;"></i> テンプレート
      </span>
    </div>
    <h1>契約書テンプレート</h1>
    <p style="margin-bottom: 0;">スプレッドシート（CSV）から流し込むための契約ひな形の登録・管理を行えます。</p>
  </div>
  <button class="btn btn-primary" onclick="openModal()">
    <i data-lucide="plus" style="width: 18px; height: 18px;"></i> テンプレートPDF登録
  </button>
</div>

<div class="glass-card" style="padding: 1.5rem; margin-bottom: 2rem;">
  <div style="font-size: 0.95rem; color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem;">
    <i data-lucide="info" style="color: var(--color-primary); flex-shrink: 0;"></i>
    <span><strong>スプレッドシート連携手順:</strong> 1.PDF登録 ➔ 2.配置編集（差し込み文字位置＆署名枠） ➔ 3.スプレッドシートからCSV書き出し ➔ 4.CSV流し込み送信</span>
  </div>
</div>

<div class="dashboard-container">
  <% if (templates.length === 0) { %>
    <div style="text-align: center; padding: 5rem 1rem; color: var(--text-secondary); border: 2px dashed rgba(255,255,255,0.05); border-radius: 12px; background: rgba(0,0,0,0.1);">
      <i data-lucide="layout-template" style="width: 48px; height: 48px; margin-bottom: 1.5rem; opacity: 0.5; color: var(--color-primary);"></i>
      <h3 style="color: #fff; margin-bottom: 0.5rem; font-size: 1.2rem;">テンプレートが登録されていません</h3>
      <p style="margin-bottom: 1.5rem; font-size: 0.9rem;">PDFファイルをここにドロップするか、登録ボタンからひな形PDFをアップロードしてください。</p>
    </div>
  <% } else { %>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>テンプレート名</th>
            <th>登録日時</th>
            <th style="text-align: right;">アクション</th>
          </tr>
        </thead>
        <tbody>
          <% templates.forEach(tmpl => { %>
            <tr>
              <td style="font-weight: 600; font-size: 1rem;"><%= tmpl.title %></td>
              <td style="font-size: 0.85rem; color: var(--text-secondary);">
                <%= new Date(tmpl.created_at).toLocaleString('ja-JP') %>
              </td>
              <td style="text-align: right;">
                <div style="display: inline-flex; gap: 0.5rem; justify-content: flex-end; align-items: center;">
                  <!-- 一括流し込み画面へ -->
                  <a href="/templates/<%= tmpl.id %>/import" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.85rem; background: var(--color-secondary); box-shadow: 0 4px 12px rgba(16, 185, 129, 0.15);">
                    <i data-lucide="table-properties" style="width: 14px; height: 14px;"></i> CSV流し込み送信
                  </a>
                  
                  <!-- ビジュアル配置編集へ -->
                  <a href="/templates/edit/<%= tmpl.id %>" class="btn btn-secondary" style="padding: 0.5rem 1rem; font-size: 0.85rem;">
                    <i data-lucide="layout-grid" style="width: 14px; height: 14px;"></i> 配置の編集
                  </a>

                  <!-- 削除ボタン -->
                  <button onclick="deleteTemplate('<%= tmpl.id %>')" class="btn btn-danger" style="padding: 0.5rem 1rem; font-size: 0.85rem;">
                    <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- 新規アップロードモーダル -->
<div class="modal-backdrop" id="uploadModal" onclick="closeModalOnBackdrop(event)">
  <div class="modal-content">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
      <h2 style="margin-bottom: 0;">ひな形テンプレート登録</h2>
      <button class="btn btn-secondary" onclick="closeModal()" style="padding: 0.25rem 0.5rem; border: none; background: transparent;">
        <i data-lucide="x"></i>
      </button>
    </div>
    
    <form id="uploadForm" onsubmit="handleUpload(event)">
      <div class="form-group">
        <label for="templateTitle">テンプレート名 (未入力の場合はファイル名)</label>
        <input type="text" id="templateTitle" placeholder="例: 【ひな形】音楽原盤制作契約書">
      </div>
      
      <div class="form-group">
        <label>PDFファイル <span style="color: var(--color-danger);">*</span></label>
        <div class="drop-zone" id="dropZone" onclick="document.getElementById('pdfFile').click()">
          <i data-lucide="file-up" style="width: 36px; height: 36px;"></i>
          <span class="drop-zone-text" id="dropZoneText">PDFファイルをここにドラッグ＆ドロップ、またはクリックして選択</span>
          <div class="drop-zone-file-info" id="fileInfo"></div>
          <input type="file" id="pdfFile" accept="application/pdf" style="display: none;" required>
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 2rem;">
        <button type="button" class="btn btn-secondary" onclick="closeModal()">キャンセル</button>
        <button type="submit" class="btn btn-primary" id="submitBtn">
          <i data-lucide="upload" style="width: 16px; height: 16px;"></i> テンプレートを登録
        </button>
      </div>
    </form>
  </div>
</div>

<!-- 画面全体ドラッグ＆ドロップ用オーバーレイ -->
<div class="drag-drop-overlay" id="dragDropOverlay">
  <div class="drag-drop-overlay-content">
    <i data-lucide="file-up" class="bounce-icon" style="width: 56px; height: 56px; color: var(--color-primary);"></i>
    <h3 style="font-size: 1.25rem; margin-bottom: 0; color: #fff;">ここにひな形PDFをドロップして登録</h3>
    <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0;">ドロップすると自動でテンプレート登録画面を起動します</p>
  </div>
</div>

<script>
  function openModal() {
    const modal = document.getElementById('uploadModal');
    modal.classList.add('show');
  }

  function closeModal() {
    const modal = document.getElementById('uploadModal');
    modal.classList.remove('show');
    document.getElementById('uploadForm').reset();
    
    const fileInfo = document.getElementById('fileInfo');
    if (fileInfo) {
      fileInfo.style.display = 'none';
      fileInfo.textContent = '';
    }
    const dropZoneText = document.getElementById('dropZoneText');
    if (dropZoneText) {
      dropZoneText.style.display = 'block';
    }
  }

  function closeModalOnBackdrop(event) {
    if (event.target === document.getElementById('uploadModal')) {
      closeModal();
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('pdfFile');
    const fileInfo = document.getElementById('fileInfo');
    const dropZoneText = document.getElementById('dropZoneText');
    const titleInput = document.getElementById('templateTitle');
    const overlay = document.getElementById('dragDropOverlay');

    if (dropZone) {
      dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('drag-over');
      });

      ['dragleave', 'dragend'].forEach(type => {
        dropZone.addEventListener(type, () => {
          dropZone.classList.remove('drag-over');
        });
      });

      dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('drag-over');

        if (e.dataTransfer.files.length > 0) {
          const file = e.dataTransfer.files[0];
          if (file.type === 'application/pdf') {
            fileInput.files = e.dataTransfer.files;
            updateFileInfo(file);
          } else {
            alert('PDFファイルのみアップロード可能です。');
          }
        }
      });
    }

    if (fileInput) {
      fileInput.addEventListener('change', () => {
        if (fileInput.files.length > 0) {
          updateFileInfo(fileInput.files[0]);
        }
      });
    }

    function updateFileInfo(file) {
      if (fileInfo && dropZoneText && titleInput) {
        fileInfo.textContent = `選択されたファイル: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`;
        fileInfo.style.display = 'block';
        dropZoneText.style.display = 'none';

        if (!titleInput.value) {
          titleInput.value = file.name.replace(/\.[^/.]+$/, "");
        }
      }
    }

    if (overlay) {
      let dragCounter = 0;

      window.addEventListener('dragenter', (e) => {
        e.preventDefault();
        dragCounter++;
        if (dragCounter === 1) {
          overlay.classList.add('show');
        }
      });

      window.addEventListener('dragover', (e) => {
        e.preventDefault();
      });

      window.addEventListener('dragleave', (e) => {
        e.preventDefault();
        dragCounter--;
        if (dragCounter === 0) {
          overlay.classList.remove('show');
        }
      });

      window.addEventListener('drop', (e) => {
        e.preventDefault();
        dragCounter = 0;
        overlay.classList.remove('show');

        if (e.dataTransfer.files.length > 0) {
          const file = e.dataTransfer.files[0];
          if (file.type === 'application/pdf') {
            openModal();
            fileInput.files = e.dataTransfer.files;
            updateFileInfo(file);
          } else {
            alert('PDFファイルのみアップロード可能です。');
          }
        }
      });
    }
  });

  async function handleUpload(event) {
    event.preventDefault();
    const title = document.getElementById('templateTitle').value;
    const fileInput = document.getElementById('pdfFile');
    const submitBtn = document.getElementById('submitBtn');

    if (!fileInput.files || fileInput.files.length === 0) {
      alert('PDFファイルを選択してください。');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i data-lucide="loader" class="animate-spin" style="width: 16px; height: 16px;"></i> アップロード中...';
    lucide.createIcons();

    const formData = new FormData();
    formData.append('templatePdf', fileInput.files[0]);
    formData.append('title', title);

    try {
      const response = await fetch('/api/templates/upload', {
        method: 'POST',
        body: formData
      });

      const result = await response.json();
      if (response.ok) {
        window.location.href = `/templates/edit/${result.id}`;
      } else {
        alert('登録失敗: ' + (result.error || '不明なエラー'));
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i data-lucide="upload" style="width: 16px; height: 16px;"></i> テンプレートを登録';
        lucide.createIcons();
      }
    } catch (err) {
      console.error(err);
      alert('通信エラーが発生しました。');
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i data-lucide="upload" style="width: 16px; height: 16px;"></i> テンプレートを登録';
      lucide.createIcons();
    }
  }

  async function deleteTemplate(id) {
    if (!confirm('このテンプレートを削除しますか？紐づくフィールド定義もすべて削除されます。')) {
      return;
    }

    try {
      const response = await fetch(`/api/templates/${id}/delete`, {
        method: 'POST'
      });

      if (response.ok) {
        window.location.reload();
      } else {
        const result = await response.json();
        alert('削除失敗: ' + (result.error || '不明なエラー'));
      }
    } catch (err) {
      console.error(err);
      alert('通信エラーが発生しました。');
    }
  }
</script>

<%- include('partials/footer') %>
