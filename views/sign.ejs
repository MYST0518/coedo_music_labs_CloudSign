<%- include('partials/header', { title: '契約書への署名' }) %>

<style>
  /* 相手方の非活性枠 */
  .signer-input-field.disabled {
    border-color: rgba(255, 255, 255, 0.1) !important;
    background: rgba(255, 255, 255, 0.03) !important;
    cursor: default !important;
    box-shadow: none !important;
  }
  .signer-input-field.disabled .field-label {
    color: var(--text-muted) !important;
    font-weight: normal !important;
  }
  /* 自分の担当枠 (甲なら青、乙ならオレンジ) */
  .signer-input-field.my-field.role-sender {
    border-color: var(--color-primary);
    background: rgba(99, 102, 241, 0.1);
    box-shadow: 0 0 10px rgba(99, 102, 241, 0.2);
  }
  .signer-input-field.my-field.role-recipient {
    border-color: var(--color-warning);
    background: rgba(245, 158, 11, 0.1);
    box-shadow: 0 0 10px rgba(245, 158, 11, 0.2);
  }
</style>

<div style="margin-bottom: 1.5rem;">
  <div style="display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
      <h1>署名手続き
        <span style="font-size: 1.1rem; margin-left: 0.5rem; padding: 0.25rem 0.75rem; border-radius: 6px; font-weight: bold; 
          <%= signer.role === 'SENDER' ? 'background: rgba(99, 102, 241, 0.2); color: var(--color-primary);' : 'background: rgba(245, 158, 11, 0.2); color: var(--color-warning);' %>">
          <%= signer.role === 'SENDER' ? '甲（自分）として署名' : '乙（相手）として署名' %>
        </span>
      </h1>
      <p style="margin-bottom: 0;">以下の手順に沿って、契約内容を確認し、指定のエリアに署名を行ってください。</p>
    </div>
    <div style="font-weight: 500; font-size: 0.9rem; color: var(--text-secondary);">
      書類: <span style="color: #fff;"><%= contract.title %></span>
    </div>
  </div>
</div>

<% if (contract.status === 'SIGNED') { %>
  <!-- すでに締結完了している場合 -->
  <div class="glass-card" style="text-align: center; padding: 3rem 1rem; border-color: var(--color-secondary); margin-bottom: 2rem;">
    <i data-lucide="check-circle" style="width: 48px; height: 48px; color: var(--color-secondary); margin-bottom: 1rem;"></i>
    <h2>この契約はすでに締結完了しています</h2>
    <p style="margin-bottom: 1.5rem;">双方の署名が完了し、最終合意書PDFが作成されました。</p>
    <a href="<%= contract.signed_file_path %>" download class="btn btn-primary" style="background: var(--color-secondary);">
      <i data-lucide="download" style="width: 16px; height: 16px;"></i>
      締結済みPDFをダウンロード
    </a>
  </div>
<% } else if (signer.signed_at) { %>
  <!-- 自分の署名は完了しているが、相手を待っている場合 -->
  <div class="glass-card" style="text-align: center; padding: 3rem 1rem; border-color: var(--color-primary); margin-bottom: 2rem;">
    <i data-lucide="clock" style="width: 48px; height: 48px; color: var(--color-primary); margin-bottom: 1rem;"></i>
    <h2>あなたの署名は受領されました</h2>
    <p style="margin-bottom: 0;">もう一方の署名者が署名手続きを行うのをお待ちください。両方の署名が完了すると、PDFのダウンロードが可能になります。</p>
  </div>
<% } %>

<div class="editor-layout">
  <!-- PDF表示エリア -->
  <div class="pdf-viewer-panel" id="pdf-viewer-panel">
    <div id="pdf-viewer" style="position: relative;">
      <div id="loading-indicator" style="text-align: center; margin-top: 3rem;">
        <i data-lucide="loader" class="animate-spin" style="width: 32px; height: 32px; color: var(--color-primary); margin-bottom: 1rem;"></i>
        <p>契約書ドキュメントを読み込んでいます...</p>
      </div>
    </div>
  </div>

  <!-- 署名手順アクションパネル -->
  <div class="sidebar-panel">
    <div class="glass-card" style="padding: 1.5rem;">
      <h3 style="font-size: 1.1rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="info" style="color: var(--color-primary);"></i>
        署名手順
      </h3>
      
      <ol style="padding-left: 1.25rem; font-size: 0.85rem; color: var(--text-secondary); display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem;">
        <li>左側の書面をスクロールして内容をご確認ください。</li>
        <li>書面内容をご確認の上、下部の同意チェックを入れて確定ボタンを押してください。</li>
      </ol>

      <div style="border-top: 1px solid var(--border-color); padding-top: 1.25rem;">
        <div style="display: flex; align-items: flex-start; gap: 0.5rem; margin-bottom: 1.25rem;">
          <input type="checkbox" id="agreementCheck" style="margin-top: 3px; cursor: pointer;" <%= (signer.signed_at || contract.status === 'SIGNED') ? 'disabled checked' : '' %>>
          <label for="agreementCheck" style="font-size: 0.85rem; cursor: pointer; color: var(--text-primary); line-height: 1.4;">
            契約書の内容に同意し、電子署名を付与することに同意します。
          </label>
        </div>

        <% if (!signer.signed_at && contract.status !== 'SIGNED') { %>
          <button onclick="submitSignature()" class="btn btn-primary" style="width: 100%;" id="submitBtn">
            <i data-lucide="check-circle" style="width: 16px; height: 16px;"></i>
            同意して確定する
          </button>
        <% } else { %>
          <button class="btn btn-secondary" style="width: 100%; cursor: not-allowed;" disabled>
            手続き完了済み
          </button>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- 署名入力用モーダル (手書き用) -->
<div class="modal-backdrop" id="signatureModal" onclick="closeModalOnBackdrop(event, 'signatureModal')">
  <div class="modal-content" style="max-width: 450px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
      <h3 style="margin-bottom: 0; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="pen-tool" style="color: var(--color-primary);"></i>
        手書き署名を入力
      </h3>
      <button class="btn btn-secondary" onclick="closeModal('signatureModal')" style="padding: 0.25rem 0.5rem; border: none; background: transparent;">
        <i data-lucide="x"></i>
      </button>
    </div>
    
    <div class="signature-pad-container">
      <canvas id="sig-canvas"></canvas>
    </div>
    
    <div class="signature-pad-actions">
      <button type="button" class="btn btn-secondary" onclick="clearSignatureCanvas()">
        <i data-lucide="rotate-ccw" style="width: 14px; height: 14px;"></i> クリア
      </button>
      <button type="button" class="btn btn-primary" onclick="saveSignature()">
        署名を適用
      </button>
    </div>
  </div>
</div>

<!-- テキスト入力用モーダル -->
<div class="modal-backdrop" id="textModal" onclick="closeModalOnBackdrop(event, 'textModal')">
  <div class="modal-content" style="max-width: 400px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
      <h3 style="margin-bottom: 0; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="type" style="color: var(--color-primary);"></i>
        テキスト入力
      </h3>
      <button class="btn btn-secondary" onclick="closeModal('textModal')" style="padding: 0.25rem 0.5rem; border: none; background: transparent;">
        <i data-lucide="x"></i>
      </button>
    </div>
    
    <div class="form-group">
      <label id="textInputLabel" for="modalTextInput">入力値</label>
      <input type="text" id="modalTextInput" placeholder="入力してください">
    </div>
    
    <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem;">
      <button type="button" class="btn btn-secondary" onclick="closeModal('textModal')">キャンセル</button>
      <button type="button" class="btn btn-primary" onclick="saveTextInput()">適用</button>
    </div>
  </div>
</div>

<!-- PDF.js CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js"></script>
<script>
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';

  const pdfUrl = '<%= contract.file_path %>';
  const token = '<%= signer.access_token %>';
  const currentSignerId = '<%= signer.id %>';
  const currentSignerRole = '<%= signer.role %>';
  const serverFields = <%- JSON.stringify(fields) %>;
  const serverSigners = <%- JSON.stringify(signers) %>;
  
  const userInputData = {}; // 自分の入力する枠のみ値を管理
  let activeFieldId = null;

  // PDF読み込み・表示処理
  const loadingTask = pdfjsLib.getDocument(pdfUrl);
  loadingTask.promise.then(async (pdf) => {
    document.getElementById('loading-indicator').remove();
    const container = document.getElementById('pdf-viewer');
    const numPages = pdf.numPages;

    for (let pageNum = 1; pageNum <= numPages; pageNum++) {
      const page = await pdf.getPage(pageNum);
      const viewport = page.getViewport({ scale: 1.25 });

      const pageContainer = document.createElement('div');
      pageContainer.className = 'pdf-page-container';
      pageContainer.dataset.page = pageNum;
      pageContainer.style.width = viewport.width + 'px';
      pageContainer.style.height = viewport.height + 'px';

      const canvas = document.createElement('canvas');
      const context = canvas.getContext('2d');
      canvas.width = viewport.width;
      canvas.height = viewport.height;
      pageContainer.appendChild(canvas);
      container.appendChild(pageContainer);

      await page.render({
        canvasContext: context,
        viewport: viewport
      }).promise;

      renderFieldsForPage(pageContainer, pageNum);
    }
    
    lucide.createIcons();
  }).catch(err => {
    console.error('PDF render error:', err);
    alert('PDFの読み込みに失敗しました。');
  });

  // ページ上の入力枠を描画 (署名不要・チェックのみで完了するため枠描画はスキップ)
  function renderFieldsForPage(pageContainer, pageNum) {
    return;
  }

  // フィールドクリックアクション (自分用)
  function handleFieldClick(fieldId, type, width, height) {
    activeFieldId = fieldId;
    
    if (type === 'signature') {
      openModal('signatureModal');
      resizeSigCanvas();
    } else if (type === 'text') {
      document.getElementById('textInputLabel').textContent = 'テキストを入力してください';
      document.getElementById('modalTextInput').value = '';
      openModal('textModal');
      setTimeout(() => document.getElementById('modalTextInput').focus(), 100);
    } else if (type === 'date') {
      const now = new Date();
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, '0');
      const date = String(now.getDate()).padStart(2, '0');
      const dateStr = `${year}/${month}/${date}`;
      applyTextToField(fieldId, dateStr, width, height);
    }
  }

  function applyTextToField(fieldId, text, width, height) {
    const canvas = document.createElement('canvas');
    canvas.width = width * 2;
    canvas.height = height * 2;
    const ctx = canvas.getContext('2d');
    
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = '#0F172A';
    
    const fontSize = Math.floor(height * 0.9);
    ctx.font = `500 ${fontSize}px sans-serif`;
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    ctx.fillText(text, 10, canvas.height / 2);
    
    const base64Data = canvas.toDataURL('image/png');
    
    const fieldEl = document.getElementById(fieldId);
    fieldEl.classList.add('completed');
    fieldEl.innerHTML = `<img src="${base64Data}">`;

    userInputData[fieldId].value = base64Data;
  }

  function openModal(modalId) {
    document.getElementById(modalId).classList.add('show');
  }

  function closeModal(modalId) {
    document.getElementById(modalId).classList.remove('show');
    activeFieldId = null;
  }

  function closeModalOnBackdrop(event, modalId) {
    if (event.target === document.getElementById(modalId)) {
      closeModal(modalId);
    }
  }

  // --- 手書き署名 (Canvas) ---
  const sigCanvas = document.getElementById('sig-canvas');
  const sigCtx = sigCanvas.getContext('2d');
  let isDrawing = false;
  let lastX = 0;
  let lastY = 0;

  function resizeSigCanvas() {
    const container = sigCanvas.parentElement;
    sigCanvas.width = container.clientWidth;
    sigCanvas.height = 180;
    sigCtx.strokeStyle = '#0F172A';
    sigCtx.lineWidth = 3;
    sigCtx.lineCap = 'round';
    sigCtx.lineJoin = 'round';
  }

  function getMousePos(canvasDom, clientX, clientY) {
    const rect = canvasDom.getBoundingClientRect();
    return { x: clientX - rect.left, y: clientY - rect.top };
  }

  sigCanvas.addEventListener('mousedown', (e) => {
    isDrawing = true;
    const pos = getMousePos(sigCanvas, e.clientX, e.clientY);
    [lastX, lastY] = [pos.x, pos.y];
  });

  sigCanvas.addEventListener('mousemove', (e) => {
    if (!isDrawing) return;
    const pos = getMousePos(sigCanvas, e.clientX, e.clientY);
    sigCtx.beginPath();
    sigCtx.moveTo(lastX, lastY);
    sigCtx.lineTo(pos.x, pos.y);
    sigCtx.stroke();
    [lastX, lastY] = [pos.x, pos.y];
  });

  sigCanvas.addEventListener('mouseup', () => isDrawing = false);
  sigCanvas.addEventListener('mouseout', () => isDrawing = false);

  sigCanvas.addEventListener('touchstart', (e) => {
    isDrawing = true;
    const touch = e.touches[0];
    const pos = getMousePos(sigCanvas, touch.clientX, touch.clientY);
    [lastX, lastY] = [pos.x, pos.y];
    e.preventDefault();
  }, { passive: false });

  sigCanvas.addEventListener('touchmove', (e) => {
    if (!isDrawing) return;
    const touch = e.touches[0];
    const pos = getMousePos(sigCanvas, touch.clientX, touch.clientY);
    sigCtx.beginPath();
    sigCtx.moveTo(lastX, lastY);
    sigCtx.lineTo(pos.x, pos.y);
    sigCtx.stroke();
    [lastX, lastY] = [pos.x, pos.y];
    e.preventDefault();
  }, { passive: false });

  sigCanvas.addEventListener('touchend', () => isDrawing = false);

  function clearSignatureCanvas() {
    sigCtx.clearRect(0, 0, sigCanvas.width, sigCanvas.height);
  }

  function saveSignature() {
    const buffer = new Uint32Array(sigCtx.getImageData(0, 0, sigCanvas.width, sigCanvas.height).data.buffer);
    const hasDrawing = buffer.some(color => color !== 0);

    if (!hasDrawing) {
      alert('署名エリアにサインを書いてください。');
      return;
    }

    const base64Data = sigCanvas.toDataURL('image/png');
    const fieldId = activeFieldId;
    const fieldEl = document.getElementById(fieldId);
    fieldEl.classList.add('completed');
    fieldEl.innerHTML = `<img src="${base64Data}">`;

    userInputData[fieldId].value = base64Data;
    closeModal('signatureModal');
  }

  function saveTextInput() {
    const textVal = document.getElementById('modalTextInput').value.trim();
    if (!textVal) {
      alert('テキストを入力してください。');
      return;
    }

    const fieldId = activeFieldId;
    const width = userInputData[fieldId].width;
    const height = userInputData[fieldId].height;

    applyTextToField(fieldId, textVal, width, height);
    closeModal('textModal');
  }

  // --- 署名結果の送信 (自分の分のみチェックして送信) ---
  async function submitSignature() {
    const agreementCheck = document.getElementById('agreementCheck');
    const submitBtn = document.getElementById('submitBtn');

    if (!agreementCheck.checked) {
      alert('「電子署名を付与することに同意する」のチェックボックスにチェックを入れてください。');
      return;
    }

    // 自分の担当枠 (isMine: true) で未入力がある場合は自動記名データをセット
    const currentSignerName = '<%= signer.name %>';
    Object.entries(userInputData).forEach(([id, data]) => {
      if (data.isMine && (data.value === null || data.value === '')) {
        data.value = currentSignerName;
      }
    });

    if (!confirm('契約内容に同意し、手続きを確定します。よろしいですか？完了後は書き換えできません。')) {
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i data-lucide="loader" class="animate-spin" style="width: 16px; height: 16px;"></i> 処理中...';
    lucide.createIcons();

    // 自分の入力した値のみを payload にセット
    const fieldValues = {};
    Object.entries(userInputData).forEach(([id, data]) => {
      if (data.isMine) {
        fieldValues[id] = data.value;
      }
    });

    try {
      const response = await fetch(`/api/sign/${token}/submit`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fieldValues })
      });

      const result = await response.json();
      if (response.ok) {
        alert('手続きが正常に完了しました。');
        window.location.reload();
      } else {
        alert('処理失敗: ' + (result.error || '不明なエラー'));
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i data-lucide="check-circle" style="width: 16px; height: 16px;"></i> 同意して確定する';
        lucide.createIcons();
      }
    } catch (err) {
      console.error(err);
      alert('通信エラーが発生しました。');
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i data-lucide="check-circle" style="width: 16px; height: 16px;"></i> 同意して確定する';
      lucide.createIcons();
    }
  }
</script>

<%- include('partials/footer') %>
