<%- include('partials/header', { title: '契約書編集' }) %>

<style>
  /* 役割別のフィールド色分け */
  .placed-field.role-sender {
    border-color: var(--color-primary) !important;
    background: rgba(99, 102, 241, 0.25) !important;
  }
  .placed-field.role-recipient {
    border-color: var(--color-warning) !important;
    background: rgba(245, 158, 11, 0.25) !important;
  }
  
  /* 役割切り替えトグル */
  .role-toggle {
    position: absolute;
    bottom: -22px;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    gap: 3px;
    z-index: 10;
  }
  .role-toggle button {
    font-size: 8px;
    font-family: inherit;
    font-weight: 600;
    padding: 2px 5px;
    border-radius: 4px;
    border: 1px solid var(--border-color);
    background: rgba(11, 15, 25, 0.95);
    color: var(--text-secondary);
    cursor: pointer;
    line-height: 1;
    transition: var(--transition-smooth);
  }
  .role-toggle button.active.sender-btn {
    background: var(--color-primary);
    color: #fff;
    border-color: var(--color-primary);
  }
  .role-toggle button.active.recipient-btn {
    background: var(--color-warning);
    color: #0b0f19;
    border-color: var(--color-warning);
  }
</style>

<div style="margin-bottom: 1.5rem;">
  <a href="/" class="btn btn-secondary" style="padding: 0.5rem 1rem; font-size: 0.85rem; margin-bottom: 1rem;">
    <i data-lucide="arrow-left" style="width: 14px; height: 14px;"></i> ダッシュボードに戻る
  </a>
  <div style="display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
      <h1>契約書へのフィールド配置</h1>
      <p style="margin-bottom: 0;">「自分」と「相手」それぞれが署名するエリアをPDF上に配置してください。</p>
    </div>
    <div style="font-weight: 500; font-size: 0.9rem; color: var(--text-secondary);">
      書類: <span style="color: #fff;"><%= contract.title %></span>
    </div>
  </div>
</div>

<div class="editor-layout">
  <!-- PDF表示エリア -->
  <div class="pdf-viewer-panel" id="pdf-viewer-panel">
    <div id="pdf-viewer">
      <div id="loading-indicator" style="text-align: center; margin-top: 3rem;">
        <i data-lucide="loader" class="animate-spin" style="width: 32px; height: 32px; color: var(--color-primary); margin-bottom: 1rem;"></i>
        <p>PDFドキュメントをレンダリングしています...</p>
      </div>
    </div>
  </div>

  <!-- 操作サイドバー -->
  <div class="sidebar-panel">
    <!-- フィールド追加 -->
    <div class="glass-card" style="padding: 1.5rem;">
      <h3 style="font-size: 1.1rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="layout-template" style="color: var(--color-primary);"></i>
        フィールドの追加
      </h3>
      <p style="font-size: 0.8rem; margin-bottom: 1rem; color: var(--text-secondary);">
        以下のアイテムをドラッグ＆ドロップし、配置後に「自分用（青）」か「相手用（橙）」かを選択してください。
      </p>

      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        <div class="draggable-field-source" draggable="true" data-type="signature">
          <i data-lucide="pen-tool" style="width: 16px; height: 16px; vertical-align: middle; margin-right: 6px;"></i>
          署名枠を追加
        </div>
        <div class="draggable-field-source" draggable="true" data-type="text">
          <i data-lucide="type" style="width: 16px; height: 16px; vertical-align: middle; margin-right: 6px;"></i>
          テキスト入力
        </div>
        <div class="draggable-field-source" draggable="true" data-type="date">
          <i data-lucide="calendar" style="width: 16px; height: 16px; vertical-align: middle; margin-right: 6px;"></i>
          日付枠を追加
        </div>
      </div>
    </div>

    <!-- 宛先設定と送信 -->
    <div class="glass-card" style="padding: 1.5rem; max-height: calc(100vh - 350px); overflow-y: auto;">
      <h3 style="font-size: 1.1rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="send" style="color: var(--color-secondary);"></i>
        宛先設定と送信
      </h3>
      
      <form id="sendForm" onsubmit="handleSend(event)">
        <!-- 署名者1（甲/自分） -->
        <h4 style="font-size: 0.9rem; margin-bottom: 0.5rem; color: var(--color-primary); display: flex; align-items: center; gap: 0.4rem;">
          <i data-lucide="user" style="width: 14px; height: 14px;"></i>
          署名者1 (甲/自分)
        </h4>
        <div class="form-group" style="margin-bottom: 0.75rem;">
          <label for="senderName">氏名 <span style="color: var(--color-danger);">*</span></label>
          <input type="text" id="senderName" value="株式会社Coedo Music Labo 代表取締役 宮下 晋" placeholder="例: 山田 太郎" required>
        </div>
        <div class="form-group" style="margin-bottom: 1.25rem;">
          <label for="senderEmail">メールアドレス <span style="color: var(--color-danger);">*</span></label>
          <input type="email" id="senderEmail" value="susumu.miyashita@coedo-music.jp" placeholder="sender@domain.com" required>
        </div>

        <hr style="border: 0; border-top: 1px solid var(--border-color); margin: 1.25rem 0;">

        <!-- 署名者2（乙/相手） -->
        <h4 style="font-size: 0.9rem; margin-bottom: 0.5rem; color: var(--color-warning); display: flex; align-items: center; gap: 0.4rem;">
          <i data-lucide="user" style="width: 14px; height: 14px;"></i>
          署名者2 (乙/相手)
        </h4>
        <div class="form-group" style="margin-bottom: 0.75rem;">
          <label for="recipientName">氏名 <span style="color: var(--color-danger);">*</span></label>
          <input type="text" id="recipientName" placeholder="例: 鈴木 花子" required>
        </div>
        <div class="form-group" style="margin-bottom: 1.5rem;">
          <label for="recipientEmail">メールアドレス <span style="color: var(--color-danger);">*</span></label>
          <input type="email" id="recipientEmail" placeholder="recipient@domain.com" required>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%;" id="sendBtn">
          <i data-lucide="send" style="width: 16px; height: 16px;"></i>
          契約送信を実行
        </button>
      </form>
    </div>
  </div>
</div>

<!-- PDF.js CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js"></script>
<script>
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';

  const pdfUrl = '<%= contract.file_path %>';
  const contractId = '<%= contract.id %>';
  let placedFields = []; // 配置されたフィールドの配列
  let fieldCounter = 0;
  let draggedType = null;

  // フィールドの標準サイズ (px)
  const fieldSizes = {
    signature: { width: 140, height: 60 },
    text: { width: 160, height: 32 },
    date: { width: 120, height: 32 }
  };

  // PDF読み込み・表示処理
  const loadingTask = pdfjsLib.getDocument(pdfUrl);
  loadingTask.promise.then(async (pdf) => {
    document.getElementById('loading-indicator').remove();
    const container = document.getElementById('pdf-viewer');
    const numPages = pdf.numPages;

    for (let pageNum = 1; pageNum <= numPages; pageNum++) {
      const page = await pdf.getPage(pageNum);
      const viewport = page.getViewport({ scale: 1.25 });

      const pageContainer = document.createElement('div');
      pageContainer.className = 'pdf-page-container';
      pageContainer.dataset.page = pageNum;
      pageContainer.style.width = viewport.width + 'px';
      pageContainer.style.height = viewport.height + 'px';

      const canvas = document.createElement('canvas');
      const context = canvas.getContext('2d');
      canvas.width = viewport.width;
      canvas.height = viewport.height;
      pageContainer.appendChild(canvas);
      container.appendChild(pageContainer);

      await page.render({
        canvasContext: context,
        viewport: viewport
      }).promise;

      initDropZone(pageContainer);
    }
    
    lucide.createIcons();
  }).catch(err => {
    console.error('PDF render error:', err);
    alert('PDFの読み込みに失敗しました。');
  });

  // ドラッグ開始
  const sources = document.querySelectorAll('.draggable-field-source');
  sources.forEach(source => {
    source.addEventListener('dragstart', (e) => {
      draggedType = source.dataset.type;
      e.dataTransfer.setData('text/plain', draggedType);
    });
  });

  // ドロップ設定
  function initDropZone(pageContainer) {
    pageContainer.addEventListener('dragover', (e) => {
      e.preventDefault();
    });

    pageContainer.addEventListener('drop', (e) => {
      e.preventDefault();
      const type = e.dataTransfer.getData('text/plain') || draggedType;
      if (!type) return;

      const rect = pageContainer.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      createField(pageContainer, type, x, y);
    });
  }

  // フィールドのDOM要素を作成し配置
  function createField(pageContainer, type, x, y, initialData = null) {
    const pageNum = parseInt(pageContainer.dataset.page);
    const size = fieldSizes[type];
    
    const pWidth = pageContainer.clientWidth;
    const pHeight = pageContainer.clientHeight;
    
    let targetX = x - (size.width / 2);
    let targetY = y - (size.height / 2);
    
    if (targetX < 0) targetX = 0;
    if (targetY < 0) targetY = 0;
    if (targetX + size.width > pWidth) targetX = pWidth - size.width;
    if (targetY + size.height > pHeight) targetY = pHeight - size.height;

    const fieldId = initialData ? initialData.id : 'f_' + (++fieldCounter);

    const fieldEl = document.createElement('div');
    fieldEl.className = 'placed-field role-sender'; // デフォルトは自分（SENDER）用
    fieldEl.id = fieldId;
    fieldEl.style.width = size.width + 'px';
    fieldEl.style.height = size.height + 'px';
    fieldEl.style.left = targetX + 'px';
    fieldEl.style.top = targetY + 'px';

    const labelMap = { signature: '署名枠', text: 'テキスト入力', date: '日付枠' };
    
    fieldEl.innerHTML = `
      <span class="field-text">${labelMap[type]} (甲)</span>
      <button class="delete-btn" type="button" onclick="deleteField('${fieldId}')">&times;</button>
      <div class="role-toggle">
        <button type="button" class="sender-btn active" onclick="setFieldRole('${fieldId}', 'SENDER')">甲</button>
        <button type="button" class="recipient-btn" onclick="setFieldRole('${fieldId}', 'RECIPIENT')">乙</button>
      </div>
    `;

    pageContainer.appendChild(fieldEl);

    // 比率の計算
    const xRatio = targetX / pWidth;
    const yRatio = targetY / pHeight;
    const widthRatio = size.width / pWidth;
    const heightRatio = size.height / pHeight;

    const fieldData = {
      id: fieldId,
      type: type,
      pageNumber: pageNum,
      xRatio: xRatio,
      yRatio: yRatio,
      widthRatio: widthRatio,
      heightRatio: heightRatio,
      role: 'SENDER' // デフォルト役割
    };

    placedFields.push(fieldData);
    
    makeDraggable(fieldEl, pageContainer, fieldData);
  }

  // 枠の対象（役割）を切り替える
  window.setFieldRole = function(fieldId, role) {
    const fieldEl = document.getElementById(fieldId);
    if (!fieldEl) return;

    const data = placedFields.find(f => f.id === fieldId);
    if (!data) return;

    data.role = role;

    const senderBtn = fieldEl.querySelector('.sender-btn');
    const recipientBtn = fieldEl.querySelector('.recipient-btn');
    const textSpan = fieldEl.querySelector('.field-text');
    const labelMap = { signature: '署名枠', text: 'テキスト入力', date: '日付枠' };

    if (role === 'SENDER') {
      fieldEl.className = 'placed-field role-sender';
      senderBtn.classList.add('active');
      recipientBtn.classList.remove('active');
      textSpan.textContent = `${labelMap[data.type]} (甲)`;
    } else {
      fieldEl.className = 'placed-field role-recipient';
      senderBtn.classList.remove('active');
      recipientBtn.classList.add('active');
      textSpan.textContent = `${labelMap[data.type]} (乙)`;
    }
  };

  // ドラッグ移動処理
  function makeDraggable(element, container, data) {
    let isDragging = false;
    let startX, startY;
    let initialLeft, initialTop;

    element.addEventListener('mousedown', (e) => {
      if (e.target.classList.contains('delete-btn') || e.target.tagName === 'BUTTON') return;
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;
      initialLeft = parseFloat(element.style.left);
      initialTop = parseFloat(element.style.top);
      element.style.zIndex = 1000;
      
      e.stopPropagation();
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      
      let newLeft = initialLeft + dx;
      let newTop = initialTop + dy;
      
      const cWidth = container.clientWidth;
      const cHeight = container.clientHeight;
      const elWidth = element.clientWidth;
      const elHeight = element.clientHeight;
      
      if (newLeft < 0) newLeft = 0;
      if (newTop < 0) newTop = 0;
      if (newLeft + elWidth > cWidth) newLeft = cWidth - elWidth;
      if (newTop + elHeight > cHeight) newTop = cHeight - elHeight;
      
      element.style.left = newLeft + 'px';
      element.style.top = newTop + 'px';
      
      data.xRatio = newLeft / cWidth;
      data.yRatio = newTop / cHeight;
    });

    document.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        element.style.zIndex = '';
      }
    });
  }

  // フィールドの削除
  window.deleteField = function(fieldId) {
    const el = document.getElementById(fieldId);
    if (el) el.remove();
    placedFields = placedFields.filter(f => f.id !== fieldId);
  };

  // 送信処理
  async function handleSend(event) {
    event.preventDefault();
    const senderName = document.getElementById('senderName').value.trim();
    const senderEmail = document.getElementById('senderEmail').value.trim();
    const recipientName = document.getElementById('recipientName').value.trim();
    const recipientEmail = document.getElementById('recipientEmail').value.trim();
    const sendBtn = document.getElementById('sendBtn');

    if (placedFields.length === 0) {
      alert('PDF上に署名欄などのフィールドを1つ以上配置してください。');
      return;
    }

    // 甲と乙両方のフィールドが少なくとも1つずつ配置されているか簡易バリデーション
    const hasSenderField = placedFields.some(f => f.role === 'SENDER');
    const hasRecipientField = placedFields.some(f => f.role === 'RECIPIENT');

    if (!hasSenderField || !hasRecipientField) {
      if (!confirm('甲（自分）または乙（相手）のどちらかに枠が配置されていません。よろしいですか？')) {
        return;
      }
    }

    if (!confirm('この内容でお互いの署名枠を確定し、署名用リンクを発行しますか？')) {
      return;
    }

    sendBtn.disabled = true;
    sendBtn.innerHTML = '<i data-lucide="loader" class="animate-spin" style="width: 16px; height: 16px;"></i> 送信中...';
    lucide.createIcons();

    try {
      const response = await fetch(`/api/contracts/${contractId}/send`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          senderName,
          senderEmail,
          recipientName,
          recipientEmail,
          fields: placedFields
        })
      });

      const result = await response.json();
      if (response.ok) {
        alert('署名用URLを発行しました。');
        window.location.href = `/contracts/detail/${contractId}`;
      } else {
        alert('送信失敗: ' + (result.error || '不明なエラー'));
        sendBtn.disabled = false;
        sendBtn.innerHTML = '<i data-lucide="send" style="width: 16px; height: 16px;"></i> 契約送信を実行';
        lucide.createIcons();
      }
    } catch (err) {
      console.error(err);
      alert('通信エラーが発生しました。');
      sendBtn.disabled = false;
      sendBtn.innerHTML = '<i data-lucide="send" style="width: 16px; height: 16px;"></i> 契約送信を実行';
      lucide.createIcons();
    }
  }
</script>
<%- include('partials/footer') %>
